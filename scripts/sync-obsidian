#!/usr/bin/env bash

set -euo pipefail

ROOT="${DOTFILES_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
VAULT="${OBSIDIAN_VAULT:-$HOME/Documents/Obsidian Vault}"
SYSTEM_DIR="$VAULT/00-系统配置"
STATE_DIR="${DOTFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles}"
MANIFEST="$ROOT/manifests/software.tsv"
CONFIG_AUDIT_SCRIPT="$ROOT/scripts/config-audit"
GENERATED_MARKER='<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->'

redact_path() {
    local path="$1"
    case "$path" in
        "$HOME") printf '%s' '$HOME' ;;
        "$HOME"/*) printf '%s/%s' '$HOME' "${path#"$HOME/"}" ;;
        *) printf '%s' "$path" ;;
    esac
}

install_generated() {
    local path="$1" tmp="$2" backup
    mkdir -p "$(dirname "$path")"
    if [ -e "$path" ] && ! grep -Fq "$GENERATED_MARKER" "$path" 2>/dev/null; then
        backup="${path}.pre-dotfiles-$(date '+%Y%m%d-%H%M%S')"
        [ -e "$backup" ] && backup="${backup}.$$"
        cp -p "$path" "$backup"
        printf 'Backed up non-generated Obsidian page: %s\n' "$backup" >&2
    fi
    mv "$tmp" "$path"
}

write_page() {
    local path="$1" tmp
    tmp=$(mktemp "${TMPDIR:-/tmp}/dotfiles-doc.XXXXXX")
    cat > "$tmp"
    install_generated "$path" "$tmp"
}

latest_inventory() {
    [ -d "$STATE_DIR" ] || return 0
    find "$STATE_DIR" -maxdepth 1 -type f -name 'inventory-*.md' -print 2>/dev/null \
        | sort | tail -1
}

render_index() {
    local path="$SYSTEM_DIR/00-索引/系统管理.md"
    {
        cat <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# 系统管理入口

这是 macOS/Linux 开发环境的统一入口。配置源码位于
EOF
        printf '%s\n' "\`$(redact_path "$ROOT")\`，部署使用 GNU Stow。"
        cat <<'EOF'

- [系统约束](../10-约束与策略/系统约束.md)
- [软件清单](../20-软件模块/软件清单.md)
- [工具选型与优化策略](../20-软件模块/工具选型与优化策略.md)
- [命令入口](../30-运行手册/命令入口.md)
- [新增软件流程](../30-运行手册/新增软件流程.md)
- [最新系统清单](../40-系统清单/inventory-latest.md)
- [配置面审计](../40-系统清单/配置面审计.md)

## 真相源

- 配置：dotfiles Git 仓库
EOF
        printf '%s\n' '- 软件：`manifests/` 清单与 Homebrew/mise/uv 实际状态'
        cat <<'EOF'
- 运行态：系统默认目录或应用目录，不复制到 Vault
- 秘密：macOS Keychain 或项目本地 secret 注入，不写入 Markdown
EOF
    } | write_page "$path"
}

render_policy() {
    write_page "$SYSTEM_DIR/10-约束与策略/系统约束.md" <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# 系统约束

## 配置

- GNU Stow 是唯一部署机制；不要手工复制配置覆盖 symlink。
- 新软件先加入 manifest，再添加配置模块、健康检查和文档。
- 任何变更先执行 `dotfiles status` 和 `dotfiles doctor`。

## 秘密与运行态

- 不同步 `.env`、auth、token、session、history、数据库、私钥、模型文件或缓存。
- 文档只记录路径、用途、权限和恢复方法，不记录秘密值。
- AI 客户端统一由 Hermes Studio 调度；Codex/OpenCode 作为受控 CLI/worker，不维护第二套常驻调度逻辑。
- Hermes profile 不创建 `~/Library/LaunchAgents/ai.hermes.gateway-*.plist`；profile 生命周期由 Hermes Studio 0.20.x 管理。
- 多个 profile 可能保留同一 Weixin token 作为本机配置，但同一时刻只允许一个 gateway 使用它；以 `dotfiles hermes` 的 fingerprint 审计为准。

## 清理与卸载

- `dotfiles cleanup` 永远只做 dry-run。
- 模型、容器 volume、项目目录和 launchd 服务必须先列出精确目标并留有回滚点。
- 不使用“一键优化/内存清理”软件作为系统依赖。

## 备份与安全

- APFS 可用空间目标至少 20%。
- FileVault、Time Machine/等价备份和防火墙状态必须有周期性审计记录。
EOF
}

render_software() {
    local path="$SYSTEM_DIR/20-软件模块/软件清单.md"
    {
        cat <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# 软件与运行时清单

| id | category | source | status | command | config |
|---|---|---|---|---|---|
EOF
        awk -F '\t' '$1 !~ /^#/ && NF >= 6 {printf "| %s | %s | %s | %s | `%s` | `%s` |\n", $1, $2, $3, $4, $5, $6}' "$MANIFEST"
        printf '\n软件状态只代表治理策略，不代表安装动作已经执行；以 `dotfiles inventory` 的实际结果为准。\n'
    } | write_page "$path"
}

render_tooling_policy() {
    write_page "$SYSTEM_DIR/20-软件模块/工具选型与优化策略.md" <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# 工具选型与优化策略

## 当前核心栈

- 终端与编辑：Ghostty、Zsh、Zellij、Neovim、Yazi、fzf、ripgrep、lazygit。
- 运行时与质量：mise 管 Node/Python，uv 管 Python 项目和 CLI，Ruff 负责 Python 检查，Go/Rust 使用官方工具链。
- AI：Hermes Studio 是唯一调度入口；Codex/OpenCode 是按需 worker；Ollama 只提供按需本地模型服务。
- 容器：OrbStack 是唯一 Docker runtime，Compose 文件只在 `dotfiles/docker/` 维护。

## review 候选

`manifests/software.tsv` 中的 `review` 只是候选，不代表已经安装。当前候选包括
`pnpm`、`bun`、`atuin`、`starship`、`difftastic`、`lazydocker`、`posting`、`watchexec`、
OnyX 和 DaisyDisk。每个候选必须先通过用途、资源占用、权限、健康检查和回滚评估。

## macOS 优化原则

- 优先使用 `dotfiles inventory`、`btop`、`diskutil`、`tmutil`、Homebrew 自带清理和项目级缓存策略。
- 不把“内存清理器”或一键优化软件作为常驻系统服务。
- DaisyDisk/OnyX 只能作为人工审阅工具，不允许加入自动清理、登录项或定时任务。
- 模型、容器 volume、Hermes 状态库和项目文件必须先确认精确目标，再进行任何清理。
- 旧 Colima 数据已隔离到 `~/Archives/dotfiles-legacy/20260805/`，只允许在确认 OrbStack 迁移完成后单独删除。

## 选择规则

1. 已有工具能稳定覆盖需求时，不新增同类工具。
2. 新工具先进入 `review`，验证后才改成 `active`。
3. 每次安装、升级或卸载后运行 `dotfiles sync`，让清单和 Obsidian 留下脱敏记录。
EOF
}

render_commands() {
    write_page "$SYSTEM_DIR/30-运行手册/命令入口.md" <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# 命令入口

从任意目录执行：

| 命令 | 作用 |
|---|---|
| `dotfiles status` | 查看仓库、分支和 symlink |
| `dotfiles inventory` | 生成脱敏系统清单 |
| `dotfiles doctor` | 检查 Stow、OrbStack、Compose、mise |
| `dotfiles hermes` | 审计 Hermes Studio profile、运行时漂移和敏感文件权限 |
| `dotfiles config` | 审计托管、运行态和 legacy 配置路径 |
| `dotfiles audit` | inventory + doctor + config + docs |
| `dotfiles sync` | inventory + config + docs |
| `dotfiles docs` | 更新本目录的生成页面 |
| `dotfiles cleanup` | 只显示清理候选，不删除任何内容 |
| `dev status/start/stop` | 兼容的开发运行时入口；不负责 Hermes profile 调度 |
| `dev reset` | 仅显示清理候选，实际清理仍由 `dotfiles cleanup` 控制 |

仓库级命令仍可使用 `./configure link|doctor` 和 `just lint|verify`。
EOF
}

render_onboarding() {
    write_page "$SYSTEM_DIR/30-运行手册/新增软件流程.md" <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# 新增软件与 Python 包流程

所有新工具先记录，再安装；安装命令不会由文档同步脚本自动执行。

## 接入步骤

1. 先运行 `dotfiles inventory`，确认当前包管理器、运行时和磁盘状态。
2. 在 `manifests/software.tsv` 增加一行，初始 `status` 使用 `review`。
3. 如果软件有配置，新增对应 Stow 包或放入现有模块；不要把 cache、session、auth、token、`.env` 放进仓库。
4. 为它补充健康检查、回滚方法和本页链接；涉及 Hermes 的 profile 只更新 `manifests/ai-profiles.tsv`，不复制 launchd plist。
5. 显式安装或升级后运行 `dotfiles config`、`dotfiles doctor` 和 `dotfiles docs`。
6. 确认实际状态后，再把 manifest 的 `status` 从 `review` 改为 `active`。

## Python 包策略

- 项目依赖使用 `uv add`，提交 `pyproject.toml` 与 `uv.lock`。
- CLI 工具使用 `uv tool install`，实际列表由 `dotfiles inventory` 记录。
- 不把全局 `pip freeze` 当作系统真相源；需要迁移时先生成清单，再逐项目验证。

## Node、Go、Rust

- Node/Python 版本由 mise 管理。
- Node CLI 先记录来源，再决定 npm/pnpm/bun；不要在 shell 启动脚本里隐式安装。
- Go 工具写入项目或专用安装清单，Rust CLI 使用 cargo/rustup 的官方路径。
EOF
}

render_config_surface() {
    {
        printf '%s\n\n' "$GENERATED_MARKER"
        "$CONFIG_AUDIT_SCRIPT"
    } | write_page "$SYSTEM_DIR/40-系统清单/配置面审计.md"
}

render_hermes_card() {
    write_page "$SYSTEM_DIR/20-软件模块/Hermes Studio.md" <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# Hermes Studio

| 字段 | 值 |
|---|---|
| source_path | `$HOME/.hermes` |
| managed_by | Hermes Studio + `dotfiles hermes` |
| role | 唯一 AI 调度入口 |
| desktop_runtime | 0.20.x（当前桌面运行时） |
| profile_services | disabled（不创建 profile 级 LaunchAgent） |
| secret_policy | `.env`、`auth.json`、provider key 和 session 只留本机；权限目标 600 |
| health_check | `dotfiles hermes`、`hermes gateway list`、Hermes Studio 桌面状态 |
| rollback | `~/Archives/dotfiles-legacy/20260805/hermes-migration-*`；只通过 0.20 CLI 逐 profile 恢复 |

## 调度边界

Codex 和 OpenCode 是由 Hermes Studio 按需调用的 worker，不维护第二套常驻调度逻辑。Ollama 只提供按需模型服务。

## 生命周期规则

- 不要手工复制或重新加载 profile LaunchAgent；这会绕过 Hermes Studio 的单一调度边界。
- `gateway install` 只在明确需要独立服务时使用，并先更新 manifest 与回滚记录。
- 迁移备份包含 auth、`.env` 和 session，只能留在本机归档目录，不能同步到 dotfiles 或 Obsidian。

## 当前风险

- 六个旧 profile 复用了同一个 Weixin token；同时常驻会产生 token conflict，当前保留配置但不再常驻启动。
- `0.19.0` runtime 目录仍被一个独立项目的 Python 进程引用；只有 `lsof` 确认无引用后才能归档，不能因 Hermes gateway 已迁移就直接删除。
- developer/tidha 等历史日志仍可能有 MCP/Weixin 错误；以计数审计为准，不直接删除状态库。
- provider 配置可能含明文 key；当前只做权限审计，密钥迁移到 Keychain/外部 secret source 需单独验证。
- 需要把审计警告当作失败时使用 `HERMES_AUDIT_STRICT=1 dotfiles hermes`。
EOF
}

render_audit_pages() {
    local audit_path="$SYSTEM_DIR/50-审计与变更/hermes-latest.md"
    {
        cat <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# Hermes 最新审计

本页由 `dotfiles docs` 生成，只记录脱敏状态；不要手工追加 token、auth、session 或日志内容。

EOF
        "$ROOT/scripts/hermes-audit"
    } | write_page "$audit_path"

    write_page "$SYSTEM_DIR/50-审计与变更/最后同步.md" <<EOF
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# 最后同步

- generated_at: $(date '+%Y-%m-%d %H:%M:%S %z')
- source: \`$(redact_path "$ROOT")\`
- command: \`dotfiles docs\`
- inventory: \`$(redact_path "$STATE_DIR")\`
- secret policy: only paths, permissions and redacted statuses are written here
EOF
}

render_inventory_readme() {
    local generated_at
    generated_at=$(date '+%Y-%m-%d %H:%M:%S %z')
    {
        cat <<'EOF'
<!-- generated by dotfiles/scripts/sync-obsidian; do not edit generated sections -->
# 系统清单

本目录只保存由 inventory 生成的脱敏报告。不要手工粘贴 auth、token、session、history 或 `.env` 内容。

EOF
        printf '生成时间：%s\n' "$generated_at"
    } | write_page "$SYSTEM_DIR/40-系统清单/README.md"
}

mkdir -p "$SYSTEM_DIR/00-索引" "$SYSTEM_DIR/10-约束与策略" \
    "$SYSTEM_DIR/20-软件模块" "$SYSTEM_DIR/30-运行手册" "$SYSTEM_DIR/40-系统清单" \
    "$SYSTEM_DIR/50-审计与变更"
mkdir -p "$STATE_DIR"
render_index
render_policy
render_software
render_tooling_policy
render_commands
render_onboarding
render_hermes_card
render_inventory_readme
render_config_surface
render_audit_pages

inventory=$(latest_inventory)
if [ -z "$inventory" ]; then
    inventory="$STATE_DIR/inventory-$(date '+%Y%m%d-%H%M%S').md"
    DOTFILES_ROOT="$ROOT" DOTFILES_STATE_DIR="$STATE_DIR" "$ROOT/scripts/system-inventory" > "$inventory"
fi
inventory_page=$(mktemp "${TMPDIR:-/tmp}/dotfiles-inventory.XXXXXX")
{
    printf '%s\n\n' "$GENERATED_MARKER"
    cat "$inventory"
} > "$inventory_page"
install_generated "$SYSTEM_DIR/40-系统清单/inventory-latest.md" "$inventory_page"
printf 'Obsidian system pages updated under %s\n' "$SYSTEM_DIR"
