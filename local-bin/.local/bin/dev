#!/bin/bash
# Managed by ~/dotfiles/local-bin; deployed with GNU Stow.
# Hermes 开发环境管理脚本
# 用法: dev <command>
#   start    - 启动所有服务
#   stop     - 停止所有服务
#   status   - 查看所有服务状态
#   docker   - Docker 命令 (dev docker ps)
#   uv       - UV 命令 (dev uv run python)
#   ollama   - Ollama 命令 (dev ollama list)
#   reset    - 重置环境 (清理缓存、重启服务)
#   help     - 显示帮助

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOME_DIR="$HOME"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

check_service() {
    local name=$1
    local cmd=$2
    if eval "$cmd" >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} $name"
        return 0
    else
        echo -e "${RED}✗${NC} $name"
        return 1
    fi
}

cmd_start() {
    echo -e "${YELLOW}=== 启动开发环境 ===${NC}"
    echo ""
    
    # 启动 OrbStack (如果 Docker Desktop 在运行则跳过)
    if pgrep -x "OrbStack" >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} OrbStack 已在运行"
    elif command -v orb >/dev/null 2>&1; then
        if orb info >/dev/null 2>&1; then
            echo -e "${GREEN}✓${NC} OrbStack 已在运行"
        else
            echo "启动 OrbStack..."
            open -a OrbStack
            sleep 3
            check_service "OrbStack" "orb info >/dev/null 2>&1"
        fi
    else
        if docker info >/dev/null 2>&1; then
            echo -e "${GREEN}✓${NC} Docker Desktop 已在运行"
        else
            echo -e "${YELLOW}!${NC} Docker/OrbStack 未运行，请先启动"
        fi
    fi
    echo ""
    
    # 启动 Ollama
    if pgrep -x "ollama" >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} Ollama 已在运行"
    else
        echo "启动 Ollama..."
        nohup ollama serve >/dev/null 2>&1 &
        sleep 2
        check_service "Ollama" "ollama list >/dev/null 2>&1"
    fi
    echo ""
    
    # 检查 Docker 容器
    echo "Docker 容器状态:"
    docker ps --format "table {{.Names}}\t{{.Status}}" 2>/dev/null || echo "  无运行中的容器"
    echo ""
    
    echo -e "${GREEN}✓ 开发环境已启动${NC}"
}

cmd_stop() {
    echo -e "${YELLOW}=== 停止开发环境 ===${NC}"
    echo ""
    
    # 停止 Ollama
    if pgrep -x "ollama" >/dev/null 2>&1; then
        echo "停止 Ollama..."
        pkill -x ollama
        sleep 1
        check_service "Ollama" "! pgrep -x ollama >/dev/null"
    else
        echo -e "${GREEN}✓${NC} Ollama 未运行"
    fi
    echo ""
    
    # 提示用户手动停止 OrbStack
    echo "如需停止 OrbStack，请手动操作:"
    echo "  open -a OrbStack && 在菜单中选择 Quit"
    echo ""
    
    echo -e "${GREEN}✓ 开发环境已停止${NC}"
}

cmd_status() {
    echo -e "${YELLOW}=== 开发环境状态 ===${NC}"
    echo ""
    
    # Docker/OrbStack
    if command -v orb >/dev/null 2>&1 && orb info >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} OrbStack: 运行中"
        echo "  版本: $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo 'N/A')"
        echo "  容器: $(docker ps -q 2>/dev/null | wc -l | tr -d ' ') 个运行中"
    elif docker info >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} Docker Desktop: 运行中"
        echo "  版本: $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo 'N/A')"
        echo "  容器: $(docker ps -q 2>/dev/null | wc -l | tr -d ' ') 个运行中"
    else
        echo -e "${RED}✗${NC} Docker: 未运行"
    fi
    echo ""
    
    # Ollama
    if pgrep -x "ollama" >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} Ollama: 运行中"
        echo "  模型:"
        ollama list 2>/dev/null | tail -n +2 | while read -r line; do
            echo "    $line"
        done
    else
        echo -e "${RED}✗${NC} Ollama: 未运行"
    fi
    echo ""
    
    # Python
    echo -e "${GREEN}✓${NC} Python:"
    if command -v uv >/dev/null 2>&1; then
        echo "  uv: $(uv --version 2>/dev/null)"
        echo "  已安装版本:"
        uv python list 2>/dev/null | grep -v "<download>" | head -5
    else
        echo "  uv: 未安装"
    fi
    echo "  系统默认: $(python3 --version 2>/dev/null || echo 'N/A')"
    echo ""
    
    # Hermes
    if [ -d "$HOME_DIR/.hermes" ]; then
        echo -e "${GREEN}✓${NC} Hermes: 已配置"
    else
        echo -e "${YELLOW}!${NC} Hermes: 未找到"
    fi
    echo ""
    
    # 磁盘使用
    echo -e "${GREEN}✓${NC} 磁盘使用:"
    echo "  Ollama 模型: $(du -sh ~/.ollama/models 2>/dev/null | cut -f1 || echo 'N/A')"
    echo "  Docker 数据: $(du -sh /var/lib/docker 2>/dev/null | cut -f1 || echo 'N/A')"
    echo ""
}

cmd_docker() {
    docker "$@"
}

cmd_uv() {
    uv "$@"
}

cmd_ollama() {
    ollama "$@"
}

cmd_reset() {
    echo -e "${YELLOW}=== 开发环境 reset 已改为审计入口 ===${NC}"
    echo "不会自动删除 Docker 资源、模型、卷或重启服务。"
    exec "${DOTFILES_ROOT:-$HOME/dotfiles}/scripts/dotfiles" cleanup
}

cmd_help() {
    cat << 'EOF'
Hermes 开发环境管理工具

用法: dev <command> [args]

命令:
  start     启动所有服务 (OrbStack/Docker, Ollama)
  stop      停止所有服务
  status    查看所有服务状态
  docker    Docker 命令 (dev docker ps)
  uv        UV 命令 (dev uv run python)
  ollama    Ollama 命令 (dev ollama list)
  reset     显示清理候选（dry-run，不删除或重启）
  help      显示此帮助

示例:
  dev start           # 启动所有服务
  dev status          # 查看状态
  dev docker ps       # 查看容器
  dev ollama list     # 查看模型
  dev uv run main.py  # 运行 Python 脚本
  dev reset           # 重置环境

环境变量:
  DEV_ENV_DEBUG=1     启用调试模式
EOF
}

# 主入口
case "${1:-help}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    status)
        cmd_status
        ;;
    docker)
        shift
        cmd_docker "$@"
        ;;
    uv)
        shift
        cmd_uv "$@"
        ;;
    ollama)
        shift
        cmd_ollama "$@"
        ;;
    reset)
        cmd_reset
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo "未知命令: $1"
        echo "运行 'dev help' 查看帮助"
        exit 1
        ;;
esac
