// ==========================================
// opencode.jsonc — OpenCode 主配置
// 部署路径: ~/.config/opencode/opencode.jsonc
// 所属包: opencode/
// 功能: AI 编码助手配置（模型路由、MCP 服务器、权限规则）
// 技术要点: 默认模型 Zen Proxy -> deepseek-v4-flash-free
// ==========================================
{
  "$schema": "https://opencode.ai/config.json",
  "model": "zen-proxy/deepseek-v4-flash-free",
  "small_model": "zen-proxy/hy3-free",
  "provider": {
    "zen-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zen (auto-failover)",
      "options": {
        "baseURL": "http://127.0.0.1:8123/v1"
      },
      "models": {
        "deepseek-v4-flash-free":  { "name": "DeepSeek V4 Flash Free" },
        "north-mini-code-free":    { "name": "North Mini Code Free" },
        "nemotron-3-ultra-free":   { "name": "Nemotron 3 Ultra Free" },
        "mimo-v2.5-free":         { "name": "MiMo V2.5 Free" },
        "hy3-free":               { "name": "HY3 Free" }
      }
    }
  },
  "enabled_providers": ["zen-proxy"],
  "formatter": false,
  "lsp": false,
  "snapshot": true,
  "autoupdate": "notify",
  "plugin": ["oh-my-openagent", "@oh-my-kiro/oh-my-kiro"],
  "instructions": ["AGENTS.md"],
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "permission": {
    "bash": {
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny",
      "> /dev/sda *": "deny",
      ":(){ :|:& };: *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "*": "ask"
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/Users/zhuyao/dotfiles"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "excalidraw": {
      "type": "local",
      "command": ["excalidraw-mcp"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://ai:***@localhost:5432/ai"],
      "enabled": false
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  }
}
